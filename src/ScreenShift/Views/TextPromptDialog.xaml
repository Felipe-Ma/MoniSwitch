<Window x:Class="ScreenShift.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24,22">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="PromptText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,7,0,0" />

            <TextBox x:Name="Input" Margin="0,14,0,0" MaxLength="60" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource Button.Ghost}"
                        IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="OK"
                        Style="{StaticResource Button.Accent}"
                        IsDefault="True"
                        Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
