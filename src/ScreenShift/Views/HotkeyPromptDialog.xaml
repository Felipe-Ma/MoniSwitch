<Window x:Class="ScreenShift.Views.HotkeyPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24,22">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,7,0,0"
                       Text="Press the key combination. It must include Ctrl, Alt or Win." />

            <!-- Not a TextBox on purpose: this displays what was captured, it never edits text. -->
            <Border Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12,10"
                    Margin="0,14,0,0">
                <TextBlock x:Name="GestureText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="…" />
            </Border>

            <TextBlock x:Name="HintText"
                       Style="{StaticResource Text.Faint}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Text="" />

            <Grid Margin="0,18,0,0">
                <Button x:Name="ClearButton"
                        Content="Remove hotkey"
                        Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left"
                        Click="OnClear" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource Button.Ghost}"
                            IsCancel="True"
                            Margin="0,0,10,0" />
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource Button.Accent}"
                            IsEnabled="False"
                            Click="OnSave" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
