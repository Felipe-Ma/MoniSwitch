<Window x:Class="ScreenShift.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ScreenShift.Views"
        Title="ScreenShift"
        Height="900" Width="1240"
        MinHeight="720" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource Brush.Bg}">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />

        <!-- Tile drawn on the layout canvas. Sized from the view model's scaled rectangle. -->
        <DataTemplate x:Key="LayoutTileTemplate">
            <Border Width="{Binding PreviewWidth}"
                    Height="{Binding PreviewHeight}"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- The monitor's name is deliberately not here: the number identifies the tile,
                         and repeating the name costs a line that small tiles cannot spare. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                        <TextBlock Text="{Binding NumberBadge}"
                                   FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <StackPanel Visibility="{Binding ShowTileDetails, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ResolutionText}"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding RefreshRateText}"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding OrientationBadgeText}"
                                       Style="{StaticResource Text.Faint}"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="7" Padding="6,2"
                            CornerRadius="4"
                            Background="{StaticResource Brush.Success}"
                            Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PRIMARY" FontSize="9" FontWeight="Bold" Foreground="#0E0E11" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card in the list below the canvas. Includes disabled monitors, which have no tile. -->
        <DataTemplate x:Key="MonitorCardTemplate">
            <Border Width="224" Margin="0,0,10,10" Padding="13,11" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                                Margin="0,0,10,0" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NumberBadge}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Text.Faint}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ResolutionText}" FontSize="18" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding RefreshRateText}" Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="·" Style="{StaticResource Text.Faint}" Margin="6,0"
                                   Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding OrientationBadgeText}" Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ScreenShift" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                </StackPanel>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================= Body ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sized so nothing here scrolls at the default window size; the scroll viewer is a
                 safety net for small windows, not part of the design. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="26,16,14,14">
                <StackPanel>

                    <!-- Enumeration failure banner -->
                    <Border Background="{StaticResource Brush.DangerSoft}"
                            BorderBrush="{StaticResource Brush.Danger}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14,12"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Could not read the display configuration"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Danger}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DISPLAYS" Style="{StaticResource Text.SectionHeader}" />

                    <!-- Scale model of the desktop. Positions come from the view model so that
                         drag-and-drop repositioning can later write straight back into them. -->
                    <Border Style="{StaticResource Card}" Height="280" Padding="1">
                        <Grid x:Name="LayoutHost" ClipToBounds="True" SizeChanged="OnLayoutHostSizeChanged">
                            <TextBlock Text="No enabled displays"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasEnabledMonitors, Converter={StaticResource BoolToVisInverted}}" />

                            <ListBox Style="{StaticResource ListBox.Bare}"
                                     ItemsSource="{Binding EnabledMonitors}"
                                     ItemTemplate="{StaticResource LayoutTileTemplate}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Bare}">
                                        <Setter Property="Canvas.Left" Value="{Binding PreviewX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding PreviewY}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding VirtualDesktopText, StringFormat='Virtual desktop {0}'}"
                               Style="{StaticResource Text.Faint}"
                               Margin="3,7,0,14" />

                    <ListBox Style="{StaticResource ListBox.Bare}"
                             ItemsSource="{Binding Monitors}"
                             ItemTemplate="{StaticResource MonitorCardTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Grid Margin="2,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROFILES" Style="{StaticResource Text.SectionHeader}"
                                   Margin="0" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Save current as profile"
                                Style="{StaticResource Button.Ghost}"
                                Padding="13,6"
                                Command="{Binding SaveProfileCommand}" />
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="18,16"
                            Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisInverted}}">
                        <StackPanel>
                            <TextBlock Text="No profiles yet" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="Arrange your displays the way you want them, then save the layout as a profile. Applying a profile puts everything back in one click, protected by the same 15-second revert." />
                        </StackPanel>
                    </Border>

                    <!-- Capped: many profiles scroll inside this list rather than growing the page. -->
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8"
                                        ToolTip="{Binding DetailToolTip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Apply" Style="{StaticResource Button.Accent}"
                                                    Padding="18,6"
                                                    Command="{Binding ApplyCommand}" />
                                            <Button Content="{Binding HotkeyButtonText}" Style="{StaticResource Button.Ghost}"
                                                    Padding="11,6" Margin="8,0,0,0" FontSize="12"
                                                    ToolTip="Global hotkey — applies this profile from anywhere, even with the window closed to the tray"
                                                    Command="{Binding SetHotkeyCommand}" />
                                            <Button Content="Update" Style="{StaticResource Button.Ghost}"
                                                    Padding="11,6" Margin="8,0,0,0" FontSize="12"
                                                    ToolTip="Overwrite this profile with the current configuration"
                                                    Command="{Binding UpdateCommand}" />
                                            <Button Content="Rename" Style="{StaticResource Button.Ghost}"
                                                    Padding="11,6" Margin="8,0,0,0" FontSize="12"
                                                    Command="{Binding RenameCommand}" />
                                            <Button Content="Duplicate" Style="{StaticResource Button.Ghost}"
                                                    Padding="11,6" Margin="8,0,0,0" FontSize="12"
                                                    Command="{Binding DuplicateCommand}" />
                                            <Button Content="Delete" Style="{StaticResource Button.Ghost}"
                                                    Foreground="{StaticResource Brush.Danger}"
                                                    Padding="11,6" Margin="8,0,0,0" FontSize="12"
                                                    Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================= Details ======================= -->
            <Border Grid.Column="1"
                    Width="380"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="Select a display to see its details"
                               Style="{StaticResource Text.Faint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverted}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="22,16,12,14"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedMonitor}">
                            <TextBlock Text="DETAILS" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,6,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Style="{StaticResource Text.Faint}" />
                                            <!-- One line each. The device and adapter paths used to
                                                 wrap to four lines apiece and made the whole panel
                                                 scroll; the full value lives in the tooltip. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}"
                                    Padding="14,12"
                                    Margin="0,8,4,0">
                                <StackPanel>
                                    <TextBlock Text="CHANGE SETTINGS" Style="{StaticResource Text.SectionHeader}" />

                                    <!-- Outside the block below on purpose: switching a monitor back
                                         on is the one setting that has to work while it is off. -->
                                    <CheckBox Content="Display is on"
                                              IsChecked="{Binding WantEnabled, Mode=TwoWay}"
                                              Margin="0,0,0,4" />

                                    <!-- The rest needs a mode list, which only a monitor that is
                                         already on can provide. -->
                                    <StackPanel Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Resolution" Style="{StaticResource Text.Faint}" Margin="0,10,0,5" />
                                    <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                              SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />

                                    <TextBlock Text="Refresh rate" Style="{StaticResource Text.Faint}" Margin="0,10,0,5" />
                                    <ComboBox ItemsSource="{Binding AvailableRefreshRates}"
                                              SelectedItem="{Binding SelectedRefreshHz, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <TextBlock Text="Orientation" Style="{StaticResource Text.Faint}" Margin="0,10,0,5" />
                                    <!-- Explicit ItemTemplate rather than DisplayMemberPath: the
                                         selection box provably honours ItemTemplate (the refresh
                                         rate picker relies on it), so the label can never regress
                                         to the record's ToString(). -->
                                    <ComboBox ItemsSource="{Binding AvailableOrientations}"
                                              SelectedItem="{Binding SelectedOrientation, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox Content="Make this the primary display"
                                              IsChecked="{Binding MakePrimary, Mode=TwoWay}"
                                              IsEnabled="{Binding CanBecomePrimary}"
                                              Margin="0,12,0,0" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button Content="Reset"
                                                Style="{StaticResource Button.Ghost}"
                                                Padding="14,6"
                                                Margin="0,0,9,0"
                                                Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Apply"
                                                Style="{StaticResource Button.Accent}"
                                                Padding="18,6"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Faint}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Text="After applying you get 15 seconds to confirm; otherwise the previous settings come back." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <!-- The two settings live down here as quiet toggles: they are set once and glanced at
             rarely, which is not worth a whole section of the page. -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="26,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Text.Faint}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />

                <CheckBox Grid.Column="1"
                          Content="Start with Windows"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                          ToolTip="Launch ScreenShift at sign-in, minimized to the tray, so profiles and hotkeys are always available" />

                <CheckBox Grid.Column="2"
                          Content="Tray icon"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"
                          IsChecked="{Binding ShowTrayIcon, Mode=TwoWay}"
                          ToolTip="Show the ScreenShift icon in the system tray" />

                <CheckBox Grid.Column="3"
                          Content="Close to tray"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"
                          IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                          IsEnabled="{Binding ShowTrayIcon}"
                          ToolTip="Closing the window keeps ScreenShift running in the tray, so global hotkeys stay active" />

                <TextBlock Grid.Column="4"
                           Text="{Binding LogFilePath}"
                           Style="{StaticResource Text.Faint}"
                           VerticalAlignment="Center"
                           MaxWidth="300"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LogFilePath}" />
            </Grid>
        </Border>
    </Grid>
</Window>
