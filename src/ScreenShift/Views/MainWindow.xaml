<Window x:Class="ScreenShift.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ScreenShift.Views"
        Title="ScreenShift"
        Height="780" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource Brush.Bg}">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />

        <!-- Tile drawn on the layout canvas. Sized from the view model's scaled rectangle. -->
        <DataTemplate x:Key="LayoutTileTemplate">
            <Border Width="{Binding PreviewWidth}"
                    Height="{Binding PreviewHeight}"
                    CornerRadius="7"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <!-- The monitor's name is deliberately not here: the number identifies the tile,
                         and repeating the name costs a line that small tiles cannot spare. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6">
                        <TextBlock Text="{Binding NumberBadge}"
                                   FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <StackPanel Visibility="{Binding ShowTileDetails, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ResolutionText}"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{Binding RefreshRateText}"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding OrientationBadgeText}"
                                       Style="{StaticResource Text.Faint}"
                                       Foreground="{StaticResource Brush.Accent}"
                                       HorizontalAlignment="Center"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                            Margin="7" Padding="6,2"
                            CornerRadius="4"
                            Background="{StaticResource Brush.Success}"
                            Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PRIMARY" FontSize="9" FontWeight="Bold" Foreground="#0E0E11" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card in the list below the canvas. Includes disabled monitors, which have no tile. -->
        <DataTemplate x:Key="MonitorCardTemplate">
            <Border Width="234" Margin="0,0,12,12" Padding="14,13" CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                                Margin="0,0,10,0" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.SurfaceHover}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding NumberBadge}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Text.Faint}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ResolutionText}" FontSize="19" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding RefreshRateText}" Style="{StaticResource Text.Muted}" Margin="0,1,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.TextFaint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="·" Style="{StaticResource Text.Faint}" Margin="6,0"
                                   Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding OrientationBadgeText}" Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding ShowOrientationBadge, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ScreenShift" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                </StackPanel>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ======================= Body ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="26,22,14,26">
                <StackPanel>

                    <!-- Enumeration failure banner -->
                    <Border Background="{StaticResource Brush.DangerSoft}"
                            BorderBrush="{StaticResource Brush.Danger}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14,12"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Could not read the display configuration"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Danger}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DISPLAYS" Style="{StaticResource Text.SectionHeader}" />

                    <!-- Scale model of the desktop. Positions come from the view model so that
                         drag-and-drop repositioning can later write straight back into them. -->
                    <Border Style="{StaticResource Card}" Height="320" Padding="1">
                        <Grid x:Name="LayoutHost" ClipToBounds="True" SizeChanged="OnLayoutHostSizeChanged">
                            <TextBlock Text="No enabled displays"
                                       Style="{StaticResource Text.Faint}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasEnabledMonitors, Converter={StaticResource BoolToVisInverted}}" />

                            <ListBox Style="{StaticResource ListBox.Bare}"
                                     ItemsSource="{Binding EnabledMonitors}"
                                     ItemTemplate="{StaticResource LayoutTileTemplate}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Bare}">
                                        <Setter Property="Canvas.Left" Value="{Binding PreviewX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding PreviewY}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding VirtualDesktopText, StringFormat='Virtual desktop {0}'}"
                               Style="{StaticResource Text.Faint}"
                               Margin="3,8,0,20" />

                    <ListBox Style="{StaticResource ListBox.Bare}"
                             ItemsSource="{Binding Monitors}"
                             ItemTemplate="{StaticResource MonitorCardTemplate}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <TextBlock Text="PROFILES" Style="{StaticResource Text.SectionHeader}" Margin="2,14,0,10" />

                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="Not built yet" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="Phase 1 covers detection only. Saving and applying profiles arrives once changing resolution, refresh rate and primary display has been proven to work on real hardware." />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ======================= Details ======================= -->
            <Border Grid.Column="1"
                    Width="380"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <TextBlock Text="Select a display to see its details"
                               Style="{StaticResource Text.Faint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverted}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="24,22,14,24"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding SelectedMonitor}">
                            <TextBlock Text="DETAILS" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,18" />

                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,10,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       Style="{StaticResource Text.Faint}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Configuration. Hidden for a disabled monitor, which has no mode list. -->
                            <Border Style="{StaticResource Card}"
                                    Padding="16,15"
                                    Margin="0,10,10,0"
                                    Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="CHANGE SETTINGS" Style="{StaticResource Text.SectionHeader}" />

                                    <TextBlock Text="Resolution" Style="{StaticResource Text.Faint}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding AvailableResolutions}"
                                              SelectedItem="{Binding SelectedResolution, Mode=TwoWay}" />

                                    <TextBlock Text="Refresh rate" Style="{StaticResource Text.Faint}" Margin="0,14,0,6" />
                                    <ComboBox ItemsSource="{Binding AvailableRefreshRates}"
                                              SelectedItem="{Binding SelectedRefreshHz, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <CheckBox Content="Make this the primary display"
                                              IsChecked="{Binding MakePrimary, Mode=TwoWay}"
                                              IsEnabled="{Binding CanBecomePrimary}"
                                              Margin="0,16,0,0" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                        <Button Content="Reset"
                                                Style="{StaticResource Button.Ghost}"
                                                Padding="14,6"
                                                Margin="0,0,9,0"
                                                Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Apply"
                                                Style="{StaticResource Button.Accent}"
                                                Padding="18,6"
                                                Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Text.Faint}"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0"
                                               Text="After applying you get 15 seconds to confirm. If you do not, the previous settings come back automatically." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="26,9">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Faint}" />
                <TextBlock Text="{Binding LogFilePath}"
                           Style="{StaticResource Text.Faint}"
                           HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LogFilePath}" />
            </Grid>
        </Border>
    </Grid>
</Window>
